# Single backend for local UI + live data (no trailing slash).
# Day-to-day live data: keep on Render (same MongoDB Atlas as production).
# Do not point at localhost unless local backend .env MONGODB_URI is that same Atlas URI
# OR you are intentionally testing unreleased local backend phases (e.g. Phase 9 tenancy).
BACKEND_ORIGIN=https://apltravelbackend.onrender.com

# Optional: public site config origin. Travel APIs use BACKEND_ORIGIN.
# During local Phase 9+ backend work, both may point at http://127.0.0.1:3000.
# PUBLIC_SITE_ORIGIN=http://127.0.0.1:3000
